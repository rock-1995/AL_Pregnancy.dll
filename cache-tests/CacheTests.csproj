<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><UseAppHost>false</UseAppHost>
    <Nullable>disable</Nullable><CheckEolTargetFramework>false</CheckEolTargetFramework><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ExtractedNearest.g.cs" />
    <Compile Include="ExtractedNearest.g.cs" />
    <Compile Include="../src/NearestBodyVertexMap.cs" Link="NearestBodyVertexMap.cs" />
    <Compile Include="../src/MatrixBridge.cs" Link="MatrixBridge.cs" />
    <Compile Include="../src/MorphMath.cs" Link="MorphMath.cs" />
  </ItemGroup>
  <Target Name="ExtractProductionNearest" BeforeTargets="BeforeCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Extract-Nearest.ps1&quot;" />
  </Target>
</Project>
